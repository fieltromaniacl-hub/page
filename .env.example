# ─── Supabase ────────────────────────────────────────────────────────────────
# El navegador solo puede leer variables con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). Solo servidor: nunca la lee el navegador.
# Se saca en Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Contraseña de la base de datos. Solo para migraciones desde el CLI.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# ─── Sitio ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─── Correo de pedidos (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
CORREO_PEDIDOS=
CORREO_REMITENTE=

# ─── Contacto ────────────────────────────────────────────────────────────────
# Formato internacional sin signos: 56912345678
NEXT_PUBLIC_WHATSAPP=
SUPABASE_POOLER_HOST=
